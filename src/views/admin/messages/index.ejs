<%- include('../partials/header') %>

<div style="margin-bottom: 24px;">
  <h1 style="font-size: 22px; font-weight: 700; font-family: var(--adm-font-mono);">
    Contact Transmission Inbox
  </h1>
  <p style="color: var(--adm-text-muted); font-size: 13px;">
    Inbound messages sent via the landing page contact terminal.
  </p>
</div>

<div class="table-card">
  <div class="table-responsive">
    <table class="admin-table">
      <thead>
        <tr>
          <th style="width: 80px;">Status</th>
          <th>Sender</th>
          <th>Subject</th>
          <th>Timestamp</th>
          <th>Email Sent</th>
          <th style="text-align: right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (!messages || messages.length === 0) { %>
          <tr>
            <td colspan="6" style="text-align: center; color: var(--adm-text-muted); padding: 36px;">
              No transmissions in inbox yet.
            </td>
          </tr>
        <% } else { %>
          <% messages.forEach(function(msg) { %>
            <tr style="<%= !msg.is_read ? 'background-color: rgba(34, 211, 238, 0.04); font-weight: 600;' : '' %>">
              <td>
                <span class="badge <%= msg.is_read ? 'badge-muted' : 'badge-warning' %>">
                  <%= msg.is_read ? 'Read' : 'NEW' %>
                </span>
              </td>
              <td>
                <div><%= msg.name %></div>
                <div style="font-size: 12px; color: var(--adm-text-muted); font-family: var(--adm-font-mono);"><%= msg.email %></div>
              </td>
              <td>
                <a href="/admin/messages/<%= msg.id %>" style="color: var(--adm-primary); text-decoration: none;">
                  <%= msg.subject || '(No Subject)' %>
                </a>
              </td>
              <td style="font-size: 13px; font-family: var(--adm-font-mono); color: var(--adm-text-muted);">
                <%= msg.created_at ? new Date(msg.created_at).toLocaleString() : '' %>
              </td>
              <td>
                <span class="badge <%= msg.email_sent ? 'badge-success' : 'badge-muted' %>">
                  <%= msg.email_sent ? 'Delivered' : 'Stored Only' %>
                </span>
              </td>
              <td style="text-align: right; white-space: nowrap;">
                <a href="/admin/messages/<%= msg.id %>" class="btn btn-secondary btn-sm" style="margin-right: 6px;">
                  Open
                </a>
                <form action="/admin/messages/<%= msg.id %>/toggle-read" method="POST" style="display: inline-block; margin-right: 6px;">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-secondary btn-sm">
                    <%= msg.is_read ? 'Mark Unread' : 'Mark Read' %>
                  </button>
                </form>
                <form action="/admin/messages/<%= msg.id %>/delete" method="POST" style="display: inline-block;" onsubmit="return confirm('Permanently delete transmission?');">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                </form>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
