<%- include('../partials/header') %>

<div style="margin-bottom: 24px;">
  <a href="/admin/messages" style="color: var(--adm-text-muted); text-decoration: none; font-size: 13px; font-family: var(--adm-font-mono);">
    ← Back to Inbox Transmissions
  </a>
  <h1 style="font-size: 22px; font-weight: 700; font-family: var(--adm-font-mono); margin-top: 8px;">
    Transmission #<%= message.id %>
  </h1>
</div>

<div class="form-card">
  <div style="border-bottom: 1px solid var(--adm-border); padding-bottom: 16px; margin-bottom: 20px;">
    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
      <div>
        <h2 style="font-size: 18px; margin-bottom: 4px;"><%= message.subject || '(No Subject)' %></h2>
        <div style="font-size: 14px; color: var(--adm-text-muted);">
          From: <strong style="color: var(--adm-text);"><%= message.name %></strong>
          &lt;<a href="mailto:<%= message.email %>" style="color: var(--adm-primary);"><%= message.email %></a>&gt;
        </div>
      </div>
      <div style="text-align: right; font-family: var(--adm-font-mono); font-size: 12px; color: var(--adm-text-muted);">
        <%= new Date(message.created_at).toLocaleString() %>
        <div style="margin-top: 4px;">
          IP: <%= message.ip_address || 'unknown' %>
        </div>
      </div>
    </div>
  </div>

  <div style="background: #080d12; border: 1px solid var(--adm-border); border-radius: 8px; padding: 20px; font-family: var(--adm-font-mono); font-size: 14px; line-height: 1.6; white-space: pre-wrap; margin-bottom: 24px;">
<%= message.message %>
  </div>

  <div style="display: flex; gap: 12px; align-items: center;">
    <a href="mailto:<%= message.email %>?subject=Re: <%= encodeURIComponent(message.subject || 'Portfolio Inquiry') %>" class="btn btn-primary" style="display: inline-flex; align-items: center; gap: 8px;">
      <%- icon('mail', { size: 16 }) %> Direct Reply via Email
    </a>
    <form action="/admin/messages/<%= message.id %>/delete" method="POST" style="margin: 0;" onsubmit="return confirm('Permanently delete transmission?');">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="btn btn-danger" style="display: inline-flex; align-items: center; gap: 8px;">
        <%- icon('trash', { size: 16 }) %> Delete Message
      </button>
    </form>
    <a href="/admin/messages" class="btn btn-secondary">
      Return to Inbox
    </a>
  </div>
</div>

<%- include('../partials/footer') %>
