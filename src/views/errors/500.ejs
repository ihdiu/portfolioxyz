<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= status || 500 %> // System Fault</title>
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/base.css">
  <style>
    body {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      text-align: center;
      padding: 24px;
      background-color: var(--bg);
      color: var(--text);
    }
    .error-box {
      max-width: 650px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 48px 32px;
    }
    .code {
      font-family: var(--font-mono);
      font-size: 72px;
      font-weight: 800;
      color: var(--accent-2);
      line-height: 1;
      margin-bottom: 12px;
    }
    p {
      color: var(--text-muted);
      margin-bottom: 24px;
    }
    pre {
      text-align: left;
      background: #000;
      padding: 16px;
      border-radius: 6px;
      overflow-x: auto;
      font-family: var(--font-mono);
      font-size: 12px;
      color: #f87171;
      margin-bottom: 24px;
    }
  </style>
</head>
<body>
  <div class="error-box">
    <div class="code"><%= status || 500 %></div>
    <h1 style="font-family: var(--font-mono); font-size: 20px; margin-bottom: 12px;">HARDWARE FAULT // SYSTEM EXCEPTION</h1>
    <p><%= message %></p>
    <% if (stack) { %>
      <pre><%= stack %></pre>
    <% } %>
    <a href="/" style="display: inline-block; padding: 10px 20px; background: var(--accent); color: #000; border-radius: 6px; text-decoration: none; font-weight: 600;">
      Reset System / Return Home
    </a>
  </div>
</body>
</html>
