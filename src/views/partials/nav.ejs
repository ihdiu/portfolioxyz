<header class="site-nav">
  <div class="container nav-container">
    <a href="#hero" class="nav-logo" aria-label="Portfolio Home">
      <span class="nav-logo-symbol"><%- icon('cpu', { size: 20 }) %></span>
      <span><%= (profile.full_name || 'Portfolio').split(' ')[0] %>.<span style="color:var(--accent);">dev</span></span>
    </a>

    <nav aria-label="Main Navigation">
      <ul class="nav-links">
        <% visibleSections.forEach(function(sec) { %>
          <li>
            <a href="#<%= sec.slug %>" class="nav-link">
              // <%= sec.slug %>
            </a>
          </li>
        <% }); %>
      </ul>
    </nav>

    <div class="nav-actions">
      <button id="theme-toggle" class="theme-toggle-btn" aria-label="Toggle visual theme" type="button">
        <span class="theme-icon-slot"><%- icon('sun', { size: 18 }) %></span>
      </button>
      <button class="nav-mobile-toggle" aria-label="Toggle navigation menu" aria-expanded="false" type="button">
        <%- icon('menu', { size: 22 }) %>
      </button>
    </div>
  </div>
</header>
