<!DOCTYPE html>
<html lang="en"
      data-theme="<%= settings.theme_default || 'dark' %>"
      data-motion="<%= settings.animations_enabled === '0' ? 'off' : 'on' %>"
      style="--accent-primary: <%= settings.accent_primary || '#22d3ee' %>; --accent-secondary: <%= settings.accent_secondary || '#f59e0b' %>;">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <!-- SEO & Social Meta -->
  <title><%= settings.site_title || `${profile.full_name} | Computer Science & Electronics Engineer` %></title>
  <meta name="description" content="<%= settings.meta_description || profile.bio || 'Portfolio of Computer Science & Electronics Engineer' %>">
  <link rel="canonical" href="<%= baseUrl %>">

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= baseUrl %>">
  <meta property="og:title" content="<%= settings.site_title || profile.full_name %>">
  <meta property="og:description" content="<%= settings.meta_description || profile.bio %>">
  <% if (settings.og_image) { %>
    <meta property="og:image" content="<%= settings.og_image.startsWith('http') ? settings.og_image : baseUrl + settings.og_image %>">
  <% } %>

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= settings.site_title || profile.full_name %>">
  <meta name="twitter:description" content="<%= settings.meta_description || profile.bio %>">

  <!-- Typography: Inter & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- Stylesheets -->
  <link rel="stylesheet" href="/css/tokens.css?v=2">
  <link rel="stylesheet" href="/css/base.css?v=2">
  <link rel="stylesheet" href="/css/components.css?v=2">
  <link rel="stylesheet" href="/css/animations.css?v=2">

  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%2322d3ee'><path d='M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5'/></svg>">

  <!-- Optional Turnstile Script -->
  <% if (config.TURNSTILE_SITE_KEY) { %>
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <% } %>

  <!-- Structured Data: JSON-LD Person Schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "<%= profile.full_name %>",
    "jobTitle": "<%= profile.headline || 'Computer Systems & Embedded Engineer' %>",
    "description": "<%= profile.bio ? profile.bio.replace(/"/g, '\\"') : '' %>",
    "email": "<%= profile.email %>",
    "url": "<%= baseUrl %>",
    "sameAs": [
      <% researchProfiles.forEach(function(rp, idx) { %>
        "<%= rp.profile_url %>"<%= idx < researchProfiles.length - 1 ? ',' : '' %>
      <% }); %>
    ]
  }
  </script>
</head>
<body>
  <!-- Dynamic Cybernetic Scenery Canvas -->
  <canvas id="bg-scenery-canvas" class="bg-scenery-canvas" aria-hidden="true"></canvas>

  <!-- Accessibility Skip Link -->
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <!-- Navigation -->
  <%- include('partials/nav') %>

  <!-- Main Landmark -->
  <main id="main-content">
    <% visibleSections.forEach(function(sec, idx) { %>
      <% if (sec.slug === 'hero') { %>
        <%- include('sections/hero', { section: sec }) %>
      <% } else if (sec.slug === 'skills') { %>
        <%- include('partials/circuit-divider') %>
        <%- include('sections/skills', { section: sec }) %>
      <% } else if (sec.slug === 'experience') { %>
        <%- include('partials/circuit-divider') %>
        <%- include('sections/experience', { section: sec }) %>
      <% } else if (sec.slug === 'education') { %>
        <%- include('partials/circuit-divider') %>
        <%- include('sections/education', { section: sec }) %>
      <% } else if (sec.slug === 'research') { %>
        <%- include('partials/circuit-divider') %>
        <%- include('sections/research', { section: sec }) %>
      <% } else if (sec.slug === 'projects') { %>
        <%- include('partials/circuit-divider') %>
        <%- include('sections/projects', { section: sec }) %>
      <% } else if (sec.slug === 'career') { %>
        <%- include('partials/circuit-divider') %>
        <%- include('sections/career', { section: sec }) %>
      <% } else if (sec.slug === 'contact') { %>
        <%- include('partials/circuit-divider') %>
        <%- include('sections/contact', { section: sec }) %>
      <% } %>
    <% }); %>
  </main>

  <!-- Footer -->
  <%- include('partials/footer') %>

  <!-- Back to Top Button -->
  <button id="back-to-top" class="back-to-top" aria-label="Back to top" type="button">
    <%- icon('arrow-up', { size: 20 }) %>
  </button>

  <!-- ES Module Application Script -->
  <script type="module" src="/js/main.js?v=2"></script>
</body>
</html>
